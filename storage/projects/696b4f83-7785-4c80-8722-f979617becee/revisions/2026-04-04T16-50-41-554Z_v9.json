      "custom_geometry": {
        "code": "const group = new THREE.Group(); const frameTopGeo = new THREE.BoxGeometry(width, height * 0.05, depth); const frameTop = new THREE.Mesh(frameTopGeo); frameTop.position.set(0, height * 0.475, 0); group.add(frameTop); const frameSideGeo = new THREE.BoxGeometry(width * 0.05, height * 0.95, depth); const frameLeft = new THREE.Mesh(frameSideGeo); frameLeft.position.set(-width * 0.475, -height * 0.025, 0); group.add(frameLeft); const frameRight = new THREE.Mesh(frameSideGeo); frameRight.position.set(width * 0.475, -height * 0.025, 0); group.add(frameRight); const doorWidth = width * 0.45; const doorHeight = height * 0.95; const doorDepth = depth * 0.2; const doorGeo = new THREE.BoxGeometry(doorWidth, doorHeight, doorDepth); const leftDoor = new THREE.Mesh(doorGeo); leftDoor.position.set(-width * 0.225, -height * 0.025, 0); group.add(leftDoor); const rightDoor = new THREE.Mesh(doorGeo); rightDoor.position.set(width * 0.225, -height * 0.025, 0); group.add(rightDoor); return group;",
        "type": "code"
      },
