      "parent_id": "house_f333387a",
      "children_ids": [],
      "custom_geometry": {
        "code": "const shape = new THREE.Shape(); const outerRadius = 0.75; const innerRadius = 0.3; for(let i=0; i<10; i++) { const r = i%2===0 ? outerRadius : innerRadius; const a = (i/10) * Math.PI * 2 + Math.PI/2; if(i===0) shape.moveTo(Math.cos(a)*r, Math.sin(a)*r); else shape.lineTo(Math.cos(a)*r, Math.sin(a)*r); } shape.closePath(); const geo = new THREE.ExtrudeGeometry(shape, {depth: 0.2, bevelEnabled: true, bevelThickness: 0.02, bevelSize: 0.02}); geo.translate(0, 0, -0.1); return geo;",
        "type": "code"
      },
