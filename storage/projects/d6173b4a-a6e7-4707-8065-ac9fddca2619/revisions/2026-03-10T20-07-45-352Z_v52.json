      "parent_id": "house_f333387a",
      "children_ids": [],
      "custom_geometry": {
        "code": "const group = new THREE.Group(); const w = 9.75, h = 1, d = 0.2; const base = new THREE.Mesh(new THREE.BoxGeometry(w, h*0.5, d)); base.position.y = -h*0.25; group.add(base); const merlonW = 0.8; const gapW = 0.4; const count = Math.floor(w / (merlonW + gapW)); const startX = -w/2 + merlonW/2 + (w - count*(merlonW+gapW) + gapW)/2; for(let i=0; i<count; i++) { const mx = startX + i*(merlonW+gapW); const mShape = new THREE.Shape(); mShape.moveTo(-merlonW/2, 0); mShape.lineTo(merlonW/2, 0); mShape.lineTo(merlonW/2, h*0.5); mShape.lineTo(merlonW/4, h*0.5); mShape.lineTo(0, h*0.2); mShape.lineTo(-merlonW/4, h*0.5); mShape.lineTo(-merlonW/2, h*0.5); mShape.closePath(); const mGeo = new THREE.ExtrudeGeometry(mShape, {depth: d, bevelEnabled: false}); mGeo.translate(mx, 0, -d/2); const mMesh = new THREE.Mesh(mGeo); group.add(mMesh); } return group;",
        "type": "code"
      },
      "cad_script": "# Custom element: Left Swallowtail Battlements\n# Description: Swallowtail (Ghibelline) battlements in front of the left roof.\n# TODO: Replace with CadQuery script when backend is ready",
