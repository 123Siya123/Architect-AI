      "custom_geometry": {
        "code": "const shape = new THREE.Shape(); const steps = 64; for (let i = 0; i <= steps; i++) { const t = (i / steps) * Math.PI * 2; const hx = 16 * Math.pow(Math.sin(t), 3); const hy = 13 * Math.cos(t) - 5 * Math.cos(2*t) - 2 * Math.cos(3*t) - Math.cos(4*t); const nx = (hx / 32) * width; const ny = ((hy + 6) / 22) * height; if (i === 0) shape.moveTo(nx, ny); else shape.lineTo(nx, ny); } const geom = new THREE.ExtrudeGeometry(shape, { depth: depth, bevelEnabled: false }); geom.center(); return geom;",
        "type": "code"
      },
