    "custom_poxqfgme": {
      "id": "custom_poxqfgme",
      "type": "Custom",
      "name": "I Love You Text",
      "position": {
        "x": 7.1,
        "y": 6,
        "z": 15
      },
      "dimensions": {
        "x": 0.2,
        "y": 2,
        "z": 8
      },
      "rotation": {
        "yaw": 0,
        "pitch": 0,
        "roll": 0
      },
      "material_id": "hot_pink_pearl_mosaic",
      "opacity": 1,
      "tags": [
        "custom"
      ],
      "constraints": {
        "connected_to": [],
        "fixed_position": false
      },
      "systems": {
        "electrical": [],
        "plumbing": [],
        "hvac": []
      },
      "parent_id": "house_01767111",
      "children_ids": [],
      "custom_geometry": {
        "code": "const group = new THREE.Group();\n\nfunction createLetter(shape, x) {\n  const geo = new THREE.ExtrudeGeometry(shape, { depth: width, bevelEnabled: true, bevelThickness: 0.02, bevelSize: 0.02, bevelSegments: 2 });\n  geo.center();\n  const mesh = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({color: 0xff007f, roughness: 0.2, metalness: 0.8}));\n  mesh.position.x = x;\n  group.add(mesh);\n}\n\nconst shapeI = new THREE.Shape(); shapeI.moveTo(0,0); shapeI.lineTo(0.2,0); shapeI.lineTo(0.2,1); shapeI.lineTo(0,1); shapeI.lineTo(0,0);\ncreateLetter(shapeI, -3.5);\n\nconst shapeL = new THREE.Shape(); shapeL.moveTo(0,0); shapeL.lineTo(0.6,0); shapeL.lineTo(0.6,0.2); shapeL.lineTo(0.2,0.2); shapeL.lineTo(0.2,1); shapeL.lineTo(0,1); shapeL.lineTo(0,0);\ncreateLetter(shapeL, -2.5);\n\nconst shapeO = new THREE.Shape(); shapeO.moveTo(0,0); shapeO.lineTo(0.6,0); shapeO.lineTo(0.6,1); shapeO.lineTo(0,1); shapeO.lineTo(0,0);\nconst holeO = new THREE.Path(); holeO.moveTo(0.2,0.2); holeO.lineTo(0.4,0.2); holeO.lineTo(0.4,0.8); holeO.lineTo(0.2,0.8); holeO.lineTo(0.2,0.2); shapeO.holes.push(holeO);\ncreateLetter(shapeO, -1.5);\n\nconst shapeV = new THREE.Shape(); shapeV.moveTo(0.3,0); shapeV.lineTo(0.6,1); shapeV.lineTo(0.4,1); shapeV.lineTo(0.2,0.2); shapeV.lineTo(0,1); shapeV.lineTo(-0.2,1); shapeV.lineTo(0.1,0); shapeV.lineTo(0.3,0);\ncreateLetter(shapeV, -0.5);\n\nconst shapeE = new THREE.Shape(); shapeE.moveTo(0,0); shapeE.lineTo(0.6,0); shapeE.lineTo(0.6,0.2); shapeE.lineTo(0.2,0.2); shapeE.lineTo(0.2,0.4); shapeE.lineTo(0.5,0.4); shapeE.lineTo(0.5,0.6); shapeE.lineTo(0.2,0.6); shapeE.lineTo(0.2,0.8); shapeE.lineTo(0.6,0.8); shapeE.lineTo(0.6,1); shapeE.lineTo(0,1); shapeE.lineTo(0,0);\ncreateLetter(shapeE, 0.5);\n\nconst shapeY = new THREE.Shape(); shapeY.moveTo(0.2,0); shapeY.lineTo(0.4,0); shapeY.lineTo(0.4,0.5); shapeY.lineTo(0.8,1); shapeY.lineTo(0.5,1); shapeY.lineTo(0.3,0.7); shapeY.lineTo(0.1,1); shapeY.lineTo(-0.2,1); shapeY.lineTo(0.2,0.5); shapeY.lineTo(0.2,0);\ncreateLetter(shapeY, 2.0);\n\nconst shapeO2 = new THREE.Shape(); shapeO2.moveTo(0,0); shapeO2.lineTo(0.6,0); shapeO2.lineTo(0.6,1); shapeO2.lineTo(0,1); shapeO2.lineTo(0,0);\nconst holeO2 = new THREE.Path(); holeO2.moveTo(0.2,0.2); holeO2.lineTo(0.4,0.2); holeO2.lineTo(0.4,0.8); holeO2.lineTo(0.2,0.8); holeO2.lineTo(0.2,0.2); shapeO2.holes.push(holeO2);\ncreateLetter(shapeO2, 3.0);\n\nconst shapeU = new THREE.Shape(); shapeU.moveTo(0,1); shapeU.lineTo(0.2,1); shapeU.lineTo(0.2,0.2); shapeU.lineTo(0.4,0.2); shapeU.lineTo(0.4,1); shapeU.lineTo(0.6,1); shapeU.lineTo(0.6,0); shapeU.lineTo(0,0); shapeU.lineTo(0,1);\ncreateLetter(shapeU, 4.0);\n\nconst box = new THREE.Box3().setFromObject(group);\nconst center = box.getCenter(new THREE.Vector3());\nconst size = box.getSize(new THREE.Vector3());\ngroup.children.forEach(c => {\n  c.position.x -= center.x;\n  c.position.y -= center.y;\n  c.position.z -= center.z;\n});\n\nconst scaleX = depth / size.x;\nconst scaleY = height / size.y;\ngroup.scale.set(scaleX, scaleY, 1);\n\ngroup.rotation.y = Math.PI / 2;\n\nreturn group;",
        "type": "code"
      },
